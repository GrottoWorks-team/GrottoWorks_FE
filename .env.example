# ---------------------------------------------------------------------------
# GrottoWorks FE — mẫu biến môi trường (copy thành `.env` rồi sửa)
#
#   cp .env.example .env
#
# `.env` đã bị gitignore; file này thì KHÔNG chứa giá trị thật.
# Chỉ biến có tiền tố VITE_ mới được nhúng vào bundle phía browser.
# ---------------------------------------------------------------------------

# Cổng dev server Vite (mặc định 5175).
VITE_DEV_PORT=5175

# Địa chỉ API Gateway (YARP) cho proxy `/api/v1` của Vite dev server.
#   docker compose : http://localhost:6102
#   BE chạy native : http://localhost:5190
VITE_API_TARGET=http://localhost:6102

# Mật khẩu của tài khoản seed (xem ACCOUNTS.md) dùng cho nút "tài khoản demo"
# ở trang đăng nhập. Để trống nếu không muốn hiện khối này.
VITE_DEMO_PASSWORD=
