# Sao chép thành .env.local rồi chỉnh nếu cần.
#
# Địa chỉ gateway BE mà Vite proxy chuyển tiếp /api/v1 tới.
#   - Chạy BE native (scripts/be-local.sh):  http://localhost:5190   ← mặc định
#   - Chạy BE bằng Docker (docker-compose):  http://localhost:6102
VITE_API_TARGET=http://localhost:5190

# Mật khẩu của các tài khoản seed dùng cho nút điền nhanh ở màn đăng nhập.
# Chỉ đổi khi seed ở máy bạn dùng mật khẩu khác.
# VITE_DEMO_PASSWORD=ChangeMe!123456
