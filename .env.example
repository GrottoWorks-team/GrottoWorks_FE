# Sao chép thành .env.local rồi chỉnh. KHÔNG commit file .env.local.
#
# ── Chọn MỘT trong hai chế độ ───────────────────────────────────────────────
#
# A. Nối Backend trên VPS (không cần Docker, .NET SDK, PostgreSQL):
#      VITE_API_BASE_URL=https://94-237-77-1.sg-sin1.upcloud.host
#    Khi biến này có giá trị, FE gọi thẳng Gateway qua HTTPS, không dùng proxy.
#    Không thêm /api/v1 vào cuối — code tự nối phần đó.
#
# B. Chạy Backend cục bộ bằng scripts/be-local.sh (gateway :5190):
#      VITE_API_TARGET=http://localhost:5190
#    Để trống VITE_API_BASE_URL thì FE gọi đường dẫn tương đối qua proxy Vite.
VITE_API_BASE_URL=

# Địa chỉ gateway cho proxy của Vite (chỉ dùng ở chế độ B).
#   - Native (scripts/be-local.sh):   http://localhost:5190   ← mặc định
#   - Docker (docker-compose):        http://localhost:6102
VITE_API_TARGET=http://localhost:5190

# Mật khẩu tài khoản demo cho nút điền nhanh ở màn đăng nhập.
# Để trống thì nút chỉ điền email, người dùng tự nhập mật khẩu.
# VITE_DEMO_PASSWORD=
