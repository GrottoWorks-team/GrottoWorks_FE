# ---------------------------------------------------------------------------
# GrottoWorks FE — mẫu biến môi trường (copy thành `.env` rồi sửa)
#
#   cp .env.example .env
#
# `.env` đã bị gitignore; file này thì KHÔNG chứa giá trị thật.
# Chỉ biến có tiền tố VITE_ mới được nhúng vào bundle phía browser.
# ---------------------------------------------------------------------------

# Cổng dev server Vite (mặc định 5175).
VITE_DEV_PORT=5175

# Địa chỉ API Gateway (YARP) cho proxy `/api/v1` của Vite dev server.
#   docker compose : http://localhost:6102
#   BE chạy native : http://localhost:5190
#   BE trên Railway (môi trường chung, mới nhất) : https://grottoworks-api.up.railway.app
#   BE trên VPS UpCloud (cũ)                    : https://94-237-77-1.sg-sin1.upcloud.host
#
# Máy nào chỉ làm Frontend (không cài Docker/.NET/PostgreSQL) thì đặt đúng
# dòng Railway/VPS ở trên, rồi `npm run dev`. Dev server tự chuyển tiếp
# `/api/v1` sang đó nên KHÔNG vướng CORS và KHÔNG phải xin ai thêm origin vào
# allowlist. Đừng đặt `VITE_API_BASE_URL`: code FE không đọc biến đó, đặt vào
# là im lặng không có tác dụng. Muốn gọi thẳng không qua proxy thì phải sửa
# code trước.
VITE_API_TARGET=http://localhost:6102

